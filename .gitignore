# R/RStudio
.Rproj.user/
.Rhistory
.RData
.Ruserdata
*.Rcheck/
*.tar.gz

# Local editor and OS metadata
.DS_Store
.posit/assistant/
# Ignore everything under .claude/ (local session state,
# settings.local.json, etc.) EXCEPT the shared, committed settings.json
# (permission allowlist plus the ai-config plugin/marketplace config),
# the shared slash commands, and the shared repo skills.
.claude/*
!.claude/settings.json
!.claude/commands
!.claude/commands/**
!.claude/skills
!.claude/skills/**
/.luarc.json

# Quarto and render artifacts
/.quarto/
/_book/
/_site/
/_slides/*
!/_slides/images/
!/_slides/images/**
/_handouts/
/_freeze/
*_cache/
*_files/
site_libs/
*.html
# Source HTML partial (injected via include-after-body), not rendered output.
!_mobile-toc.html
# Source HTML partial (theme dropdown), likewise not rendered output.
!theme-picker.html
*.pdf
*-handout.docx
*.aux
*.log
*.tex
*.toc
*.rmarkdown
*.idx
*.ilg
*.ind
Intro-to-GLMs.pdf
test.qmd
rsconnect/

# Rendered Markdown is noisy, but keep hand-written project docs visible.
*.md
!README.md
!CLAUDE.md
!CODE_OF_CONDUCT.md
!LICENSE.md
# Keep the shared .claude slash commands and skills (their .md files override *.md above).
!.claude/commands/**
!.claude/skills/**
!SUBMODULE_SETUP.md
!.github/**/*.md

**/*.quarto_ipynb

# renv files
renv/library/
renv/local/
renv/cellar/
renv/lock/
renv/python/
renv/sandbox/
renv/staging/
.aider*

# Python bytecode
**/__pycache__/
*.pyc
